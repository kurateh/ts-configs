{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "format": {
      "cache": false
    },
    "format:check": {},
    "test": {},
    "//#lint:root": {
      "dependsOn": ["^build"]
    },
    "//#lint:root:fix": {
      "dependsOn": ["^build"],
      "cache": false
    }
  }
}
